generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id          String   @id @default(uuid()) @db.Uuid
  owner       String
  identity    String
  workKey     String?
  editionKey  String?
  title       String
  author      String
  coverUrl    String?
  uploadedCover BookCover?
  status      String   @default("want")
  tags        String[] @default([])
  plannedYears Int[]   @default([])
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  readings    Reading[]

  @@unique([owner, identity])
  @@index([owner, createdAt])
}

model BookCover {
  bookId String @id @db.Uuid
  bytes  Bytes
  mime   String
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Reading {
  bookId   String  @db.Uuid
  id       String  @db.Uuid
  position Int
  format   String
  started String?
  currentPage Int?
  totalPages Int?
  progressPercent Float?
  days     String[] @default([])
  finished String?
  rating   Float?
  favorite Boolean
  review   String
  book     Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([bookId, id])
}

model JournalYear {
  owner    String
  year     Int
  revision Int   @default(1)
  squares  Json
  letters  Json
  colors   Json
  monthly  Json
  rounds   Json

  @@id([owner, year])
}

model Competition {
  id          String   @id @default(uuid()) @db.Uuid
  owner       String
  name        String
  challengeId String?  @unique @db.Uuid
  revision    Int      @default(1)
  slots       Json
  votes       Json
  createdAt   DateTime @default(now())

  @@index([owner, createdAt])
}
