# Banco local ou Neon. Substitua os valores pelos do seu próprio projeto.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/paginarium
FIREBASE_PROJECT_ID=seu-projeto-firebase
WEB_ORIGIN=http://localhost:5173
